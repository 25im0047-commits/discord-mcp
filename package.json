{
  "name": "discord-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated read-only Discord Bot MCP for Cloudflare Workers",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --import ./tests/register-workers.js --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/discord.js && node --check src/security.js && node --check src/server.js && node --check src/oauth.js",
    "dev": "wrangler dev --ip 127.0.0.1",
    "build": "wrangler deploy --dry-run --outdir dist",
    "smoke": "node tests/worker-smoke.js",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.28.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
